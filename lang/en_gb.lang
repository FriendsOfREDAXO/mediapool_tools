mediapool_tools_broken_media_summary_title = Result
mediapool_tools_broken_media_summary_text = {0} of {1} files with issues:
mediapool_tools_broken_media_actions_hint = "Delete" only works if the file is not in use (media pool check). Damaged files can be replaced with an intact one in the media pool detail view – the file name on the left opens it. "Fix extension" renames the file and updates all references in the database (like merging duplicates).
